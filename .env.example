# docker compose için; gerçek değerleri .env dosyasına yaz (commit'leme).
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
ADMIN_KEY=change-me-admin
# ea-site (FC27) | mock
INGESTION_PROVIDER=ea-site
INGESTION_GAME_VERSION=27

# ML servisi paylasilan anahtari (backend -> ml)
ML_SHARED_SECRET=
# Yalnizca yerel gelistirme: sahte odeme saglayicisini acar (prod'da false birak)
BILLING_STUB_ENABLED=false

# E-posta doğrulaması (BE-SEC-06): sağlayıcı seçilince yalnız bu değerler değişir. MAIL_HOST boşsa doğrulama kapalı.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@localhost
WEB_BASE_URL=http://localhost:8081
# İlk admin hesabı (kayıtlı ya da kayıt olacak e-posta); uygulama açılışında ve kayıtta ADMIN yapılır.
FCAREER_BOOTSTRAP_ADMIN_EMAIL=
# Kayıt hız sınırı (prod: 5). Yerel geliştirmede gate betikleri için .env'de SPRING_PROFILES_ACTIVE=dev yeterli (application-dev.yml: 1000).
FCAREER_RATELIMIT_REGISTER_DAILY_PER_IP=5
# Yerel: dev | Prod (Railway): prod — application-prod.yml (CORS yalnız WEB_BASE_URL, Actuator yalnız health, e-posta doğrulaması zorunlu,
# sahte ödeme kapalı). Prod'da MAIL_HOST/MAIL_USERNAME/MAIL_PASSWORD/MAIL_FROM ve https WEB_BASE_URL yoksa uygulama açılmaz (ProdConfigGuard).
SPRING_PROFILES_ACTIVE=

# --- PROD-PREP: prod değişkenleri (değerler Railway ortamında; buraya yazılmaz) ---
# Ücretsiz beta: true iken herkes PREMIUM haklarını alır, arayüz "Beta: tüm özellikler ücretsiz" der. Kodda varsayılan false; prod'da true.
FCAREER_FREE_BETA=
# Günlük kredi üst sınırı: her gün (Europe/Istanbul) bakiye bunun altındaysa buna tamamlanır, birikmez. Varsayılan 30.
FCAREER_DAILY_CREDITS=
# İstemci IP'si: true iken X-Real-IP (Railway edge → web nginx) okunur. Yalnız ters vekil arkasında true; backend'in herkese açık adresi olmamalı.
# Yerel compose'da nginx bağlantı adresini X-Real-IP olarak iletir; true bırakmak yerelde de istemci başına sayaç sağlar.
FCAREER_TRUST_PROXY=
# Çapraz köken izinleri (virgülle). Prod profilinde yok sayılır: yalnız WEB_BASE_URL izinlidir.
CORS_ALLOWED_ORIGINS=
# Brevo SMTP (prod): MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587 (STARTTLS), MAIL_USERNAME/MAIL_PASSWORD Brevo SMTP anahtarı,
# MAIL_FROM Brevo'da doğrulanmış gönderici. WEB_BASE_URL: https://<servis>.up.railway.app (doğrulama bağlantısı ve CORS).
