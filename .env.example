# docker compose için; gerçek değerleri .env dosyasına yaz (commit'leme).
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
ADMIN_KEY=change-me-admin
# ea-site (FC27) | mock
INGESTION_PROVIDER=ea-site
INGESTION_GAME_VERSION=27

# ML servisi paylasilan anahtari (backend -> ml)
ML_SHARED_SECRET=
# Yalnizca yerel gelistirme: sahte odeme saglayicisini acar (prod'da false birak)
BILLING_STUB_ENABLED=false

# E-posta doğrulaması (BE-SEC-06): sağlayıcı seçilince yalnız bu değerler değişir. MAIL_HOST boşsa doğrulama kapalı.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@localhost
WEB_BASE_URL=http://localhost:8081
# İlk admin hesabı (kayıtlı ya da kayıt olacak e-posta); uygulama açılışında ve kayıtta ADMIN yapılır.
FCAREER_BOOTSTRAP_ADMIN_EMAIL=
REGISTRATIONS_PER_IP_DAILY=5
